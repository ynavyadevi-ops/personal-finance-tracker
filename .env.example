# =====================================================================
# Personal Finance Tracker — Environment Configuration Template
# =====================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env:
#      copy .env.example .env
# 2. Update SECRET_KEY with a cryptographically secure random string:
#      python -c "import secrets; print(secrets.token_urlsafe(32))"
# 3. For local desktop use, default 127.0.0.1 settings are pre-configured.
# 4. NEVER commit your actual .env file or production secrets to Git.
# =====================================================================

# --- Application Runtime Environment ---
ENVIRONMENT=development
DEBUG=true
APP_NAME="Personal Finance Tracker"
APP_VERSION="0.1.0"
API_V1_PREFIX=/api/v1

# --- Local Network & Binding (Loopback Only) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501
API_BASE_URL=http://127.0.0.1:8000/api/v1

# --- Database Storage ---
# SQLite file storage for local offline single-user desktop deployment:
DATABASE_URL=sqlite:///./data/finance.db
# PostgreSQL storage for enterprise multi-user deployment (future):
# DATABASE_URL=postgresql://user:password@localhost:5432/finance_tracker

# --- Cryptography & Session Security ---
# Replace with a cryptographically generated 256-bit key in production:
SECRET_KEY=dev-insecure-secret-key-for-local-development-only-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Cross-Origin Resource Sharing (CORS) ---
# Comma-separated list of trusted origins permitted to make cross-origin requests:
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# --- Optional AI Financial Insights ---
# AI insights are disabled by default and require explicit in-app user opt-in consent:
AI_INSIGHTS_ENABLED=false
